# 이 파일을 복사해 이름을 .env 로 바꾸고, 필요한 값만 채우세요. .env 는 이 컴퓨터에만 두고 다른 곳에 올리지 마세요.
# 아무것도 채우지 않아도 프로그램은 돌아갑니다(자유 대화 대신 정해진 상담 순서와 버튼으로 진행).

# 자유 대화(Gemini). Google AI Studio 에서 받은 키
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 선택: 제주데이터허브 API 583을 조회할 때만 실행 기관의 프로젝트 키를 입력합니다.
# 데이터 API 키는 제출 ZIP에 포함하지 않습니다. 비워 두어도 기본 상권 비교는 동작합니다.
HUB_PROJECT_KEY=

# 일반 상담용 카카오 지도: 실행 주소를 등록한 JavaScript 키만 입력합니다(REST/Admin 키 아님).
KAKAO_MAP_JS_KEY=

# OpenAI 일반 상담: 로컬은 --provider openai, 공개 웹은 서버 환경 변수로 설정합니다.
# 개인 운영 키 대신 평가 전용 키를 사용합니다. OPENAI_PROJECT는 선택 항목입니다.
OPENAI_API_KEY=
OPENAI_PROJECT=
OPENAI_MODEL=gpt-6-luna
